<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationTitle>NUKE HOUR</ApplicationTitle>
    <IpaPackageName>NUKE HOUR.ipa</IpaPackageName>
    <ApplicationId>com.openra.ipad.personal</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>17</ApplicationVersion>
    <TargetedDeviceFamily>1,2</TargetedDeviceFamily>
    <DevelopmentTeam>267KQ4A3N4</DevelopmentTeam>
    <TargetPlatform>ios</TargetPlatform>
    <PublicClean Condition="'$(PublicClean)' == ''">false</PublicClean>
    <PublicAuditReportDir>$(MSBuildProjectDirectory)/../../artifacts/public-ios</PublicAuditReportDir>
	<LegacyIosTouchAssetExcludes>../../mods/ra2/uibits/ios-touch-*-allies.png;../../mods/ra2/uibits/ios-touch-*-allies-2x.png;../../mods/ra2/uibits/ios-touch-*-soviets.png;../../mods/ra2/uibits/ios-touch-*-soviets-2x.png;../../mods/ra2/uibits/ios-touch-*-yuri.png;../../mods/ra2/uibits/ios-touch-*-yuri-2x.png</LegacyIosTouchAssetExcludes>
    <!-- Mod code is fully AOT compiled. The generated direct-construction registry
         preserves all manifest/YAML object constructors without an interpreter. -->
    <ApplicationSupportsIndirectInputEvents>true</ApplicationSupportsIndirectInputEvents>
    <!-- OpenRA discovers mod loader and actor types through reflection. Keep
         their constructors available to the iOS AOT compiler. -->
    <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
    <MtouchLink>None</MtouchLink>
    <UseMonoRuntime>true</UseMonoRuntime>
    <MtouchInterpreter></MtouchInterpreter>
    <GeneratedAotRegistryFile>$(MSBuildProjectDirectory)/GeneratedAotObjectRegistry.g.cs</GeneratedAotRegistryFile>
    <RootNamespace>OpenRA.iOS</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublicClean)' == 'true'">
    <DefineConstants>$(DefineConstants);PUBLIC_CLEAN</DefineConstants>
    <ApplicationTitle>NUKE HOUR</ApplicationTitle>
    <IpaPackageName>NUKE HOUR-PublicClean.ipa</IpaPackageName>
  </PropertyGroup>
  <ItemGroup>
	<!-- Asset catalogs are deny-by-default so PublicClean cannot accidentally
	     compile a newly added private imageset into its opaque Assets.car. -->
	<ImageAsset Remove="Assets.xcassets/**/*" />
	<ImageAsset Include="Assets.xcassets/Contents.json" />
	<ImageAsset Include="Assets.xcassets/LaunchBackground.colorset/Contents.json" />
	<NativeReference Include="native/$(RuntimeIdentifier)/libOpenRAMetricKit.a">
	  <Kind>Static</Kind>
	  <ForceLoad>true</ForceLoad>
	  <Frameworks>MetricKit Foundation</Frameworks>
	</NativeReference>
	<ImageAsset Include="Assets.xcassets/AppIcon.appiconset/Contents.json" Condition="'$(PublicClean)' != 'true'" />
	<ImageAsset Include="Assets.xcassets/AppIcon.appiconset/*.png" Condition="'$(PublicClean)' != 'true'" />
	<ImageAsset Include="Assets.xcassets/PublicAppIcon.appiconset/Contents.json" Condition="'$(PublicClean)' == 'true'">
	  <Link>Assets.xcassets/AppIcon.appiconset/Contents.json</Link>
	</ImageAsset>
	<ImageAsset Include="Assets.xcassets/PublicAppIcon.appiconset/*.png" Condition="'$(PublicClean)' == 'true'">
	  <Link>Assets.xcassets/AppIcon.appiconset/%(Filename)%(Extension)</Link>
	</ImageAsset>
	<BundleResource Include="en.lproj/InfoPlist.strings" LogicalName="en.lproj/InfoPlist.strings" Optimize="false" />
	<BundleResource Include="zh-Hans.lproj/InfoPlist.strings" LogicalName="zh-Hans.lproj/InfoPlist.strings" Optimize="false" />
	<ProjectReference Include="../../engine/OpenRA.Game/OpenRA.Game.csproj" />
    <ProjectReference Include="../OpenRA.Platforms.iOS/OpenRA.Platforms.iOS.csproj" />
    <ProjectReference Include="../../OpenRA.Mods.RA2/OpenRA.Mods.RA2.csproj" />
    <NativeReference Include="native/$(RuntimeIdentifier)/libSDL2.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <Frameworks>AVFoundation AudioToolbox CoreAudio CoreBluetooth CoreGraphics CoreHaptics CoreMotion Foundation GameController Metal OpenGLES QuartzCore UIKit</Frameworks>
    </NativeReference>
    <NativeReference Include="native/$(RuntimeIdentifier)/libSDL2-platform-stubs.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
    </NativeReference>
    <NativeReference Include="native/$(RuntimeIdentifier)/libfreetype.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
    </NativeReference>
  </ItemGroup>
  <Target Name="GenerateAotObjectRegistry" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../build/OpenRA.AotRegistry.Generator/OpenRA.AotRegistry.Generator.csproj&quot; --configuration Release --no-launch-profile -- &quot;$(GeneratedAotRegistryFile)&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Game.dll&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Mods.Common.dll&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Mods.Cnc.dll&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Mods.RA2.dll&quot;" />
  </Target>
  <ItemGroup Condition="'$(PublicClean)' != 'true'">
    <BundleResource Include="../../engine/VERSION" Link="VERSION" />
    <BundleResource Include="../../engine/global mix database.dat" Link="global mix database.dat" />
    <BundleResource Include="../../engine/glsl/**/*">
      <Link>glsl/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
	<BundleResource Include="../../engine/mods/**/*" Exclude="../../engine/mods/ra2/**/*">
      <Link>mods/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
	<!-- The repository-level RA2 tree below is the canonical source.  Excluding
	     the stale engine snapshot prevents duplicate bundle paths. -->
	<BundleResource Include="../../mods/ra2/**/*" Exclude="../../mods/ra2/**/*.svg;$(LegacyIosTouchAssetExcludes)">
      <Link>mods/ra2/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2-content/**/*" Exclude="../../mods/ra2-content/.DS_Store;../../mods/ra2-content/**/.DS_Store">
      <Link>mods/ra2-content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
  </ItemGroup>
  <ItemGroup Condition="'$(PublicClean)' == 'true'">
    <!-- Public builds are allowlisted. Retail data and maps remain excluded.
         Presentation resources below are covered by the approved public manifest. -->
    <BundleResource Include="../../engine/VERSION" Link="VERSION" />
    <BundleResource Include="../../engine/global mix database.dat" Link="global mix database.dat" />
    <BundleResource Include="../../engine/glsl/**/*">
      <Link>glsl/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../engine/mods/common/**/*">
      <Link>mods/common/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../engine/mods/common-content/**/*">
      <Link>mods/common-content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2-content/**/*" Exclude="../../mods/ra2-content/.DS_Store;../../mods/ra2-content/**/.DS_Store">
      <Link>mods/ra2-content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/*.yaml">
      <Link>mods/ra2/%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/AUTHORS">
      <Link>mods/ra2/AUTHORS</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/audio/**/*.yaml">
      <Link>mods/ra2/audio/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <!-- Every file below this tree is individually hash-locked in the public
         manifest: GPL community support art or NUKE HOUR project originals.
         Future/unreviewed additions are copied but make the bundle audit fail. -->
    <BundleResource Include="../../mods/ra2/bits/**/*">
      <Link>mods/ra2/bits/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/chrome/**/*.yaml">
      <Link>mods/ra2/chrome/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/fluent/**/*.ftl">
      <Link>mods/ra2/fluent/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/fonts/**/*">
      <Link>mods/ra2/fonts/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/rules/**/*.yaml">
      <Link>mods/ra2/rules/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/sequences/**/*.yaml">
      <Link>mods/ra2/sequences/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/tilesets/**/*.yaml">
      <Link>mods/ra2/tilesets/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/uibits/**/*" Exclude="../../mods/ra2/uibits/**/*.svg;$(LegacyIosTouchAssetExcludes)">
      <Link>mods/ra2/uibits/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/weapons/**/*.yaml">
      <Link>mods/ra2/weapons/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
  </ItemGroup>
  <ItemGroup>
	<!-- V3 is the sole shipping touch skin. Keep the source-controlled V2 atlases
	     only as reproducibility history and exclude them from every app bundle. -->
	<BundleResource Remove="../../mods/ra2/uibits/ios-touch-*-allies.png;../../mods/ra2/uibits/ios-touch-*-allies-2x.png;../../mods/ra2/uibits/ios-touch-*-soviets.png;../../mods/ra2/uibits/ios-touch-*-soviets-2x.png;../../mods/ra2/uibits/ios-touch-*-yuri.png;../../mods/ra2/uibits/ios-touch-*-yuri-2x.png" />
  </ItemGroup>
  <!-- Deleted BundleResource files can survive incremental iOS builds.  Remove
       the retired RA2 loading image before bundle assembly, then fail the build
       if the finished personal bundle is not byte-for-byte current. -->
  <Target Name="PreparePersonalIosLoadingBrandBundle" BeforeTargets="_CreateAppBundle" DependsOnTargets="_GenerateBundleName" Condition="'$(PublicClean)' != 'true'">
	<ItemGroup>
	  <_LegacyIosTouchBundleAsset Include="$(AppBundleDir)/mods/ra2/uibits/ios-touch-*-allies.png;$(AppBundleDir)/mods/ra2/uibits/ios-touch-*-allies-2x.png;$(AppBundleDir)/mods/ra2/uibits/ios-touch-*-soviets.png;$(AppBundleDir)/mods/ra2/uibits/ios-touch-*-soviets-2x.png;$(AppBundleDir)/mods/ra2/uibits/ios-touch-*-yuri.png;$(AppBundleDir)/mods/ra2/uibits/ios-touch-*-yuri-2x.png" />
	</ItemGroup>
	<Delete Files="@(_LegacyIosTouchBundleAsset)" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/ios_loading_brand_audit.py&quot; prepare --app-bundle &quot;$(AppBundleDir)&quot;" />
  </Target>
  <!-- ACTool makes LogicalName project-relative. With an external ArtifactsPath
       that becomes a traversal path, so the SDK copies these files outside the
       .app. The three known root icon outputs must keep root logical names. -->
  <Target Name="NormalizeIosAssetCatalogLogicalNames"
    AfterTargets="_CompileImageAssets"
    BeforeTargets="_ComputeBundleResourceOutputPaths"
    Condition="'$(UseArtifactsOutput)' == 'true'">
    <PropertyGroup>
      <_IosActoolBundleRoot>$([System.IO.Path]::GetFullPath('$(DeviceSpecificIntermediateOutputPath)actool/bundle'))/</_IosActoolBundleRoot>
    </PropertyGroup>
    <ItemGroup>
      <_IosActoolBundleResource Include="@(_BundleResourceWithLogicalName)"
        Condition="$([System.String]::Copy('%(_BundleResourceWithLogicalName.FullPath)').StartsWith('$(_IosActoolBundleRoot)'))" />
      <_IosActoolAssetsCar Include="@(_IosActoolBundleResource)"
        Condition="'%(_IosActoolBundleResource.Filename)%(_IosActoolBundleResource.Extension)' == 'Assets.car'" />
      <_IosActoolPhoneIcon Include="@(_IosActoolBundleResource)"
        Condition="'%(_IosActoolBundleResource.Filename)%(_IosActoolBundleResource.Extension)' == 'AppIcon60x60@2x.png'" />
      <_IosActoolTabletIcon Include="@(_IosActoolBundleResource)"
        Condition="'%(_IosActoolBundleResource.Filename)%(_IosActoolBundleResource.Extension)' == 'AppIcon76x76@2x~ipad.png'" />
    </ItemGroup>
    <Error Condition="@(_IosActoolBundleResource->Count()) != 3"
      Text="ACTool must produce exactly the three expected root icon resources under $(_IosActoolBundleRoot)." />
    <Error Condition="@(_IosActoolAssetsCar->Count()) != 1"
      Text="ACTool output is missing or duplicated: Assets.car" />
    <Error Condition="@(_IosActoolPhoneIcon->Count()) != 1"
      Text="ACTool output is missing or duplicated: AppIcon60x60@2x.png" />
    <Error Condition="@(_IosActoolTabletIcon->Count()) != 1"
      Text="ACTool output is missing or duplicated: AppIcon76x76@2x~ipad.png" />
    <ItemGroup>
      <_BundleResourceWithLogicalName Update="@(_IosActoolBundleResource)">
        <LogicalName>%(_BundleResourceWithLogicalName.Filename)%(_BundleResourceWithLogicalName.Extension)</LogicalName>
      </_BundleResourceWithLogicalName>
    </ItemGroup>
  </Target>
  <Target Name="AuditIosApplicationBrand" AfterTargets="_CreateAppBundle" BeforeTargets="_CodesignAppBundle">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/ios_app_brand_audit.py&quot; &quot;$(AppBundleDir)&quot; --source-root &quot;$(MSBuildProjectDirectory)/../..&quot;" />
  </Target>
  <Target Name="AuditPersonalIosLoadingBrandBundle" AfterTargets="_CreateAppBundle" DependsOnTargets="AuditIosApplicationBrand" Condition="'$(PublicClean)' != 'true'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/ios_loading_brand_audit.py&quot; audit --app-bundle &quot;$(AppBundleDir)&quot; --source-mod-root &quot;$(MSBuildProjectDirectory)/../../mods/ra2&quot;" />
  </Target>
  <Target Name="AuditPersonalIosTouchRuntimeBundle" AfterTargets="_CreateAppBundle" BeforeTargets="_CodesignAppBundle" DependsOnTargets="AuditPersonalIosLoadingBrandBundle" Condition="'$(PublicClean)' != 'true' and '$(RuntimeIdentifier)' == 'ios-arm64'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/audit_ios_touch_runtime_bundle.py&quot; &quot;$(AppBundleDir)&quot; --source-root &quot;$(MSBuildProjectDirectory)/../..&quot; --managed-output-root &quot;$(TargetDir)&quot;" />
  </Target>
  <Target Name="AuditPublicBundle" AfterTargets="_CreateAppBundle" DependsOnTargets="AuditIosApplicationBrand" Condition="'$(PublicClean)' == 'true'">
    <MakeDir Directories="$(PublicAuditReportDir)" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/public_bundle_audit.py&quot; --root &quot;$(AppBundleDir)&quot; --manifest &quot;$(MSBuildProjectDirectory)/../../packaging/ios/public_clean_manifest.json&quot; --json-report &quot;$(PublicAuditReportDir)/public-bundle-audit.json&quot; --markdown-report &quot;$(PublicAuditReportDir)/public-bundle-audit.md&quot;" />
  </Target>
  <!-- OpenRA's desktop NuGet dependencies carry macOS dylibs.  They are not
       valid iOS binaries and must not reach the iOS install-name/link steps. -->
  <Target Name="RemoveDesktopNativeLibrariesFromIosBundle" BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'lua51.dylib' Or '%(Filename)%(Extension)' == 'freetype6.dylib' Or '%(Filename)%(Extension)' == 'soft_oal.dylib' Or '%(Filename)%(Extension)' == 'SDL2.dylib'" />
    </ItemGroup>
  </Target>
</Project>
