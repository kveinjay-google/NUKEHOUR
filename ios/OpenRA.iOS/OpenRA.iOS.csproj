	<ImageAsset Include="Assets.xcassets/AppIcon.appiconset/*.png" Condition="'$(PublicClean)' != 'true'" />
	<ImageAsset Include="Assets.xcassets/PublicAppIcon.appiconset/Contents.json" Condition="'$(PublicClean)' == 'true'">
	  <Link>Assets.xcassets/AppIcon.appiconset/Contents.json</Link>
	</ImageAsset>
	<ImageAsset Include="Assets.xcassets/PublicAppIcon.appiconset/*.png" Condition="'$(PublicClean)' == 'true'">
	  <Link>Assets.xcassets/AppIcon.appiconset/%(Filename)%(Extension)</Link>
	</ImageAsset>
	<BundleResource Include="en.lproj/InfoPlist.strings" LogicalName="en.lproj/InfoPlist.strings" Optimize="false" />
	<BundleResource Include="zh-Hans.lproj/InfoPlist.strings" LogicalName="zh-Hans.lproj/InfoPlist.strings" Optimize="false" />
	<ProjectReference Include="../../engine/OpenRA.Game/OpenRA.Game.csproj" />
    <ProjectReference Include="../OpenRA.Platforms.iOS/OpenRA.Platforms.iOS.csproj" />
    <ProjectReference Include="../../OpenRA.Mods.RA2/OpenRA.Mods.RA2.csproj" />
    <NativeReference Include="native/$(RuntimeIdentifier)/libSDL2.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <Frameworks>AVFoundation AudioToolbox CoreAudio CoreBluetooth CoreGraphics CoreHaptics CoreMotion Foundation GameController Metal OpenGLES QuartzCore UIKit</Frameworks>
    </NativeReference>
    <NativeReference Include="native/$(RuntimeIdentifier)/libSDL2-platform-stubs.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
    </NativeReference>
    <NativeReference Include="native/$(RuntimeIdentifier)/libfreetype.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
    </NativeReference>
  </ItemGroup>
  <Target Name="WriteRuntimeContractDescriptorInput">
    <PropertyGroup>
      <RuntimeContractDescriptorInputFile Condition="'$(RuntimeContractDescriptorInputFile)' == ''">$(IntermediateOutputPath)runtime-contract-descriptors-v1.tsv</RuntimeContractDescriptorInputFile>
    </PropertyGroup>
    <Error Condition="@(RuntimeContractDescriptor->Count()) != 296"
      Text="RuntimeContractDescriptor must contain exactly the 296 reviewed golden rows." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <_RuntimeContractDescriptorInputRow Include="@(RuntimeContractDescriptor->'%(Identity)&#x9;%(LogicalName)&#x9;%(BundleRelativePath)&#x9;%(Profiles)&#x9;%(Purpose)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(RuntimeContractDescriptorInputFile)"
      Lines="@(_RuntimeContractDescriptorInputRow)" Overwrite="true" />
  </Target>
  <!-- A direct GenerateAotObjectRegistry invocation starts at this project and
       asks ResolveProjectReferences to build three overlapping dependency
       graphs.  Serialize only that direct dependency walk: multi-node MSBuild
       can otherwise strand the outer target while the child graphs converge.
       During a normal Build the references have already resolved before this
       preparation target runs, so the regular build graph remains unchanged. -->
  <Target Name="PrepareAotObjectRegistryGeneration">
    <PropertyGroup>
      <BuildInParallel>false</BuildInParallel>
    </PropertyGroup>
  </Target>
  <Target Name="GenerateAotObjectRegistry" BeforeTargets="CoreCompile" Condition="'$(PublicClean)' != 'true'"
    DependsOnTargets="PrepareAotObjectRegistryGeneration;ResolveProjectReferences;WriteRuntimeContractDescriptorInput">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../build/OpenRA.AotRegistry.Generator/OpenRA.AotRegistry.Generator.csproj&quot; --configuration Release --no-launch-profile -- &quot;$(GeneratedAotRegistryFile)&quot; &quot;$(RuntimeContractDescriptorInputFile)&quot; &quot;$(RuntimeContractDescriptorShapeFile)&quot; &quot;$(RuntimeContractDescriptorShapeFileSha256)&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Game.dll&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Mods.Common.dll&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Mods.Cnc.dll&quot; &quot;$(MSBuildProjectDirectory)/../../engine/bin/OpenRA.Mods.RA2.dll&quot;" />
  </Target>
  <Target Name="ValidatePublicAotObjectRegistry" BeforeTargets="CoreCompile" Condition="'$(PublicClean)' == 'true'">
    <!-- The private recovery tree regenerates this file from all 296 historical
         descriptors.  The public projection deliberately omits unlicensed
         descriptor assets, so it must consume only that authenticated output. -->
    <GetFileHash Files="$(GeneratedAotRegistryFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_GeneratedAotRegistryHash" />
    </GetFileHash>
    <Error Condition="'@(_GeneratedAotRegistryHash->'%(FileHash)')' != '$(GeneratedAotRegistryFileSha256)'"
      Text="PublicClean requires the authenticated Build 4 GeneratedAotObjectRegistry.g.cs." />
  </Target>
  <ItemGroup Condition="'$(PublicClean)' != 'true'">
    <!-- Runtime files are transported only through the authenticated literal
         descriptor projection.  Optimize=false preserves the exact hashed bytes. -->
    <BundleResource Include="@(RuntimeContractDescriptor)"
      LogicalName="%(BundleRelativePath)"
      Link="%(BundleRelativePath)"
      Optimize="false" RuntimeContractDerived="true" />
    <BundleResource Include="../../mods/ra2-content/**/*">
      <Link>mods/ra2-content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
  </ItemGroup>
  <ItemGroup Condition="'$(PublicClean)' == 'true'">
    <!-- Public builds are allowlisted.  Binary art, maps, fonts, and retail data
         remain excluded until their provenance is explicitly approved. -->
    <BundleResource Include="../../engine/mods/common/**/*">
      <Link>mods/common/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../engine/mods/common-content/**/*">
      <Link>mods/common-content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2-content/**/*">
      <Link>mods/ra2-content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/*.yaml">
      <Link>mods/ra2/%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/AUTHORS">
      <Link>mods/ra2/AUTHORS</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/audio/**/*.yaml">
      <Link>mods/ra2/audio/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/bits/animations/nc-impact-*.png">
      <Link>mods/ra2/bits/animations/%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/chrome/**/*.yaml">
      <Link>mods/ra2/chrome/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/fluent/**/*.ftl">
      <Link>mods/ra2/fluent/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/rules/**/*.yaml">
      <Link>mods/ra2/rules/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/sequences/**/*.yaml">
      <Link>mods/ra2/sequences/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/tilesets/**/*.yaml">
      <Link>mods/ra2/tilesets/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Include="../../mods/ra2/weapons/**/*.yaml">
      <Link>mods/ra2/weapons/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </BundleResource>
    <BundleResource Remove="../../mods/ra2/audio/voices-base.yaml" />
    <BundleResource Remove="../../mods/ra2/mod.ios-base.yaml" />
    <BundleResource Remove="../../mods/ra2/mod.ios-yuri.yaml" />
    <BundleResource Remove="../../mods/ra2/rules/allied-infantry-base.yaml" />
    <BundleResource Remove="../../mods/ra2/rules/defaults-base.yaml" />
    <BundleResource Remove="../../mods/ra2/rules/proxy-actors-base.yaml" />
    <BundleResource Remove="../../mods/ra2/rules/soviet-infantry-base.yaml" />
    <BundleResource Remove="../../mods/ra2/rules/soviet-vehicles-base.yaml" />
    <BundleResource Remove="../../mods/ra2/rules/world-base.yaml" />
    <BundleResource Remove="../../mods/ra2/sequences/vehicles-base.yaml" />
    <BundleResource Remove="../../mods/ra2/sequences/voxels-base.yaml" />
  </ItemGroup>
  <!-- Mono's iOS AOT hard binding records the exact MVID of referenced
       assemblies.  The SDK's per-assembly incremental check can otherwise
       retain dependents compiled against an older MVID, which aborts before
       managed startup in aot-only mode.  Treat every linked assembly as one
       dependency closure whenever any member changes. -->
  <Target Name="InvalidateIosAotDependencyClosure"
    BeforeTargets="_AOTCompile"
    DependsOnTargets="_LoadLinkerOutput"
    Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and '$(_RunAotCompiler)' == 'true' and '$(IsMacEnabled)' == 'true'"
    Inputs="@(_AssembliesToAOT)"
    Outputs="$(DeviceSpecificIntermediateOutputPath)aot-dependency-closure.stamp">
    <Message Importance="High" Text="A managed AOT input changed; invalidating the complete iOS AOT dependency closure." />
    <Delete Files="@(_AssembliesToAOT->'%(AOTData)');@(_AssembliesToAOT->'%(AOTAssembly)');@(_AssembliesToAOT->'%(LLVMFile)');@(_AssembliesToAOT->'%(ObjectFile)')" />
  </Target>
  <!-- Commit the incremental stamp only after every invalidated AOT module has
       compiled successfully.  Interrupted builds therefore retry the closure. -->
  <Target Name="StampIosAotDependencyClosure"
    AfterTargets="_AOTCompile"
    Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and '$(_RunAotCompiler)' == 'true' and '$(IsMacEnabled)' == 'true' and '@(_AssembliesToAOT)' != ''">
    <Touch Files="$(DeviceSpecificIntermediateOutputPath)aot-dependency-closure.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(DeviceSpecificIntermediateOutputPath)aot-dependency-closure.stamp" />
    </ItemGroup>
  </Target>
  <!-- Deleted BundleResource files can survive incremental iOS builds.  Remove
       the retired RA2 loading image before bundle assembly, then fail the build
       if the finished personal bundle is not byte-for-byte current. -->
  <Target Name="PreparePersonalIosLoadingBrandBundle" BeforeTargets="_CreateAppBundle" DependsOnTargets="_GenerateBundleName" Condition="'$(PublicClean)' != 'true'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/ios_loading_brand_audit.py&quot; prepare --app-bundle &quot;$(AppBundleDir)&quot;" />
  </Target>
  <!-- ACTool can make LogicalName a traversal path rooted at its intermediate
       output for both in-tree and external artifact layouts. Route both build
       layouts through one fail-closed normalization core. -->
  <Target Name="NormalizeIosAssetCatalogLogicalNames"
    AfterTargets="_CompileImageAssets"
    BeforeTargets="_ComputeBundleResourceOutputPaths"
    Condition="'$(UseArtifactsOutput)' == 'true'"
    DependsOnTargets="NormalizeIosAssetCatalogLogicalNamesCore" />
  <Target Name="NormalizeInTreeIosAssetCatalogLogicalNames"
    AfterTargets="_CompileImageAssets"
    BeforeTargets="_ComputeBundleResourceOutputPaths"
    Condition="'$(UseArtifactsOutput)' != 'true'"
    DependsOnTargets="NormalizeIosAssetCatalogLogicalNamesCore" />
  <Target Name="NormalizeIosAssetCatalogLogicalNamesCore">
    <PropertyGroup>
      <_IosActoolBundleRoot>$([System.IO.Path]::GetFullPath('$(DeviceSpecificIntermediateOutputPath)actool/bundle'))/</_IosActoolBundleRoot>
    </PropertyGroup>
    <ItemGroup>
      <_IosActoolBundleResource Include="@(_BundleResourceWithLogicalName)"
        Condition="$([System.String]::Copy('%(_BundleResourceWithLogicalName.FullPath)').StartsWith('$(_IosActoolBundleRoot)'))" />
      <_IosActoolAssetsCar Include="@(_IosActoolBundleResource)"
        Condition="'%(_IosActoolBundleResource.Filename)%(_IosActoolBundleResource.Extension)' == 'Assets.car'" />
      <_IosActoolPhoneIcon Include="@(_IosActoolBundleResource)"
        Condition="'%(_IosActoolBundleResource.Filename)%(_IosActoolBundleResource.Extension)' == 'AppIcon60x60@2x.png'" />
      <_IosActoolTabletIcon Include="@(_IosActoolBundleResource)"
        Condition="'%(_IosActoolBundleResource.Filename)%(_IosActoolBundleResource.Extension)' == 'AppIcon76x76@2x~ipad.png'" />
    </ItemGroup>
    <Error Condition="@(_IosActoolBundleResource->Count()) != 3"
      Text="ACTool must produce exactly the three expected root icon resources under $(_IosActoolBundleRoot)." />
    <Error Condition="@(_IosActoolAssetsCar->Count()) != 1"
      Text="ACTool output is missing or duplicated: Assets.car" />
    <Error Condition="@(_IosActoolPhoneIcon->Count()) != 1"
      Text="ACTool output is missing or duplicated: AppIcon60x60@2x.png" />
    <Error Condition="@(_IosActoolTabletIcon->Count()) != 1"
      Text="ACTool output is missing or duplicated: AppIcon76x76@2x~ipad.png" />
    <ItemGroup>
      <_BundleResourceWithLogicalName Update="@(_IosActoolBundleResource)">
        <LogicalName>%(_BundleResourceWithLogicalName.Filename)%(_BundleResourceWithLogicalName.Extension)</LogicalName>
      </_BundleResourceWithLogicalName>
    </ItemGroup>
  </Target>
  <Target Name="AuditIosApplicationBrand" AfterTargets="_CreateAppBundle" BeforeTargets="_CodesignAppBundle">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/ios_app_brand_audit.py&quot; &quot;$(AppBundleDir)&quot; --source-root &quot;$(MSBuildProjectDirectory)/../..&quot;" />
  </Target>
  <Target Name="AuditPersonalIosLoadingBrandBundle" AfterTargets="_CreateAppBundle" DependsOnTargets="AuditIosApplicationBrand" Condition="'$(PublicClean)' != 'true'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/ios_loading_brand_audit.py&quot; audit --app-bundle &quot;$(AppBundleDir)&quot; --source-mod-root &quot;$(MSBuildProjectDirectory)/../../mods/ra2&quot;" />
  </Target>
  <Target Name="AuditPersonalIosTouchRuntimeBundle" AfterTargets="_CreateAppBundle" BeforeTargets="_CodesignAppBundle" DependsOnTargets="AuditPersonalIosLoadingBrandBundle" Condition="'$(PublicClean)' != 'true' and '$(RuntimeIdentifier)' == 'ios-arm64'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/audit_ios_touch_runtime_bundle.py&quot; &quot;$(AppBundleDir)&quot; --source-root &quot;$(MSBuildProjectDirectory)/../..&quot; --managed-output-root &quot;$(TargetDir)&quot;" />
  </Target>
  <Target Name="AuditPublicBundle" AfterTargets="_CreateAppBundle" DependsOnTargets="AuditIosApplicationBrand" Condition="'$(PublicClean)' == 'true'">
    <MakeDir Directories="$(PublicAuditReportDir)" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../packaging/public_bundle_audit.py&quot; --root &quot;$(AppBundleDir)&quot; --manifest &quot;$(MSBuildProjectDirectory)/../../packaging/public-content-manifest.json&quot; --json-report &quot;$(PublicAuditReportDir)/public-bundle-audit.json&quot; --markdown-report &quot;$(PublicAuditReportDir)/public-bundle-audit.md&quot;" />
  </Target>
  <!-- OpenRA's desktop NuGet dependencies carry macOS dylibs.  They are not
       valid iOS binaries and must not reach the iOS install-name/link steps. -->
  <Target Name="RemoveDesktopNativeLibrariesFromIosBundle" BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'lua51.dylib' Or '%(Filename)%(Extension)' == 'freetype6.dylib' Or '%(Filename)%(Extension)' == 'soft_oal.dylib' Or '%(Filename)%(Extension)' == 'SDL2.dylib'" />
    </ItemGroup>
  </Target>
</Project>
