+				for (var j = 0; j < i; j++)
+					Assert.That(roles[i].ToRectangle().IntersectsWith(roles[j].ToRectangle()), Is.False,
+						$"Visible roles {roles[j].ToRectangle()} and {roles[i].ToRectangle()} overlap.");
+			}
