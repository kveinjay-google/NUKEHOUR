+			WriteChunk(output, "IHDR", BuildHeader(1, 1));
+			WriteChunk(output, "IDAT", compressed[..(compressed.Length / 2)]);
+			WriteChunk(output, "tEXt", new byte[] { (byte)'a', 0 });
+			WriteChunk(output, "IDAT", compressed[(compressed.Length / 2)..]);
+			WriteChunk(output, "IEND", Array.Empty<byte>());
