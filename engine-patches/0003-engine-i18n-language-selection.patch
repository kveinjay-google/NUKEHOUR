+				var paths = WithLanguageOverrides(modData.Manifest.FluentMessages, language, fileSystem);
+				modFluentBundle = new FluentBundle(culture, paths, fileSystem);
 				if (fileSystem is Map map && map.FluentMessageDefinitions != null)
