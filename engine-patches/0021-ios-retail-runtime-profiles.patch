+		public void Post(Action action)
+		{
+			if (action == null)
+				throw new ArgumentNullException(nameof(action));
+
+			lock (syncRoot)
+			{
+				if (disposed)
+					throw new ObjectDisposedException(nameof(GameLifecycleDispatchLane));
+
+				actions.Enqueue(action);
+				workAvailable.Set();
+			}
+		}
