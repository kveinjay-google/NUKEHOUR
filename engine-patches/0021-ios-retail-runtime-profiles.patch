+		sealed class RecordingRuntimeRoot : IIosRuntimeResourceRoot
+		{
+			readonly IReadOnlyDictionary<string, byte[]> payloads;
+
+			public List<string> AcquiredPaths { get; } = new();
+			public List<string> VerifiedPaths { get; } = new();
