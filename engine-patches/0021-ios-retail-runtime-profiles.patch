+
+			public EpochService(List<string> events) { this.events = events; }
+
+			public IDisposable Bind(ModData modData)
+			{
+				events.Add("bind");
+				return new CallbackToken(() => events.Add("unbind"));
+			}
+
+			public void Dispose()
+			{
+				System.Threading.Interlocked.Increment(ref disposeCalls);
