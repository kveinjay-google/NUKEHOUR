+					element.GetProperty("profiles").EnumerateArray().Select(p => p.GetString()!).ToArray(),
+					element.GetProperty("purpose").GetString()!);
+			}).ToArray();
+
+			return new GoldenShape(
+				root.GetProperty("schemaVersion").GetInt32(),
