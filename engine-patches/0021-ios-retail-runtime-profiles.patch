+							break;
+						action = actions.Dequeue();
+					}
+
+					action();
+					processed++;
+				}
+
+				return processed;
+			}
+
+			public void Dispose()
+			{
+				lock (actions)
+					disposed = true;
+				posts.Dispose();
+			}
+		}
