+				Assert.That(five.Controls[0].Y, Is.EqualTo(six.Controls[0].Y));
+				Assert.That(five.Controls[^1].Bottom, Is.EqualTo(six.Controls[^1].Bottom));
+			});
+
+			for (var i = 1; i < five.Controls.Length; i++)
+				Assert.That(five.Controls[i - 1].Bottom, Is.LessThanOrEqualTo(five.Controls[i].Y));
