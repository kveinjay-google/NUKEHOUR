+					safeLeft, safeTop, safeRight, safeBottom));
+			var six = IosMainMenuLayout.Create(policy, 6);
+			var five = IosMainMenuLayout.Create(policy, 5);
+
+			Assert.Multiple(() =>
+			{
+				Assert.That(five.Panel, Is.EqualTo(six.Panel),
+					"Removing Quit must not collapse the established main-menu frame.");
