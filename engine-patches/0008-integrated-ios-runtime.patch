diff -ruN a/OpenRA.Game/GeneratedAotObjectRegistry.cs b/OpenRA.Game/GeneratedAotObjectRegistry.cs
--- a/OpenRA.Game/GeneratedAotObjectRegistry.cs	1969-12-31 16:00:00
