+			Assert.That(incomplete.Yuri, Is.EqualTo(ContentState.Incomplete));
+			Assert.That(incomplete.CanLaunchYuriGame, Is.False);
+			Assert.That(ready.Yuri, Is.EqualTo(ContentState.Ready));
