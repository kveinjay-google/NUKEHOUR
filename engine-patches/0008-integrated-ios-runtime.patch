+				Assert.That(shake.Duration, Is.EqualTo(expected.ShakeDuration));
+				Assert.That(shake.Intensity, Is.EqualTo(expected.ShakeIntensity));
+				Assert.That(shake.Multiplier, Is.EqualTo(new float2(1, 1)));
