+		{
+			var root = RepositoryRoot();
+			foreach (var path in new[]
+			{
+				Path.Combine(root, "mods", "ra2", "rules", "yuri-vehicles.yaml"),
+				Path.Combine(root, "engine", "mods", "ra2", "rules", "yuri-vehicles.yaml")
