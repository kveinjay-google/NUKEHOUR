+		static byte[] RgbaPng(int width, int height, Func<int, byte> red)
+		{
+			var data = new byte[width * height * 4];
+			for (var i = 0; i < width * height; i++)
+			{
+				data[4 * i] = red(i);
+				data[4 * i + 3] = 255;
+			}
+
+			return new Png(data, SpriteFrameType.Rgba32, width, height).Save();
+		}
