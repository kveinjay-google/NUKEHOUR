+	public static class NearbyGameNetworking
+	{
+		const string AddressPrefix = "nearby://";
+		static readonly object Sync = new();
+		static readonly IReadOnlyList<NearbyGameInfo> NoGames = Array.Empty<NearbyGameInfo>();
