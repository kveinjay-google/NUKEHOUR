+			Assert.That(status.Yuri, Is.EqualTo(ContentState.Missing));
+		}
+
+		[Test]
+		public void OptionalAudioDoesNotControlBaseLaunchReadiness()
+		{
+			var incomplete = catalog.Inspect(new[] { "ra2.mix", "language.mix", "audio.bag" });
+			var ready = catalog.Inspect(new[] { "ra2.mix", "language.mix", "AUDIO.BAG", "audio.idx" });
+
+			Assert.That(incomplete.Audio, Is.EqualTo(ContentState.Incomplete));
+			Assert.That(incomplete.CanLaunchBaseGame, Is.True);
+			Assert.That(ready.Audio, Is.EqualTo(ContentState.Ready));
+		}
+
+		[Test]
