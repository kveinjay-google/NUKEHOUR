+
+		[TestCase(1, -1, true)]
+		[TestCase(299, 1, false)]
+		[TestCase(300, 1, true)]
+		[TestCase(600, 300, true)]
+		public void DevelopmentHeartbeatMarksFirstAndPeriodicFrames(int frame, int lastFrame, bool expected)
