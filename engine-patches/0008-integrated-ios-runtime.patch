+
+		public IosSupportPowerLayout(
+			IosSupportPowerLayoutMode mode,
+			bool fitsAll,
+			IReadOnlyList<Rectangle> cells,
+			Rectangle placementBounds,
+			Size cellSize,
+			int gap,
+			int margin)
+		{
+			Mode = mode;
+			FitsAll = fitsAll;
+			Cells = cells ?? Array.Empty<Rectangle>();
