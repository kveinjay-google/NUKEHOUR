+				var mapTitle = section.GetOrNull("MAP_TITLE");
+				if (mapTitle != null)
+					mapTitle.Bounds = new WidgetBounds(0, mapBackground?.Bounds.Bottom ?? 0,
+						section.Bounds.Width, titleHeight);
+			}
+		}
