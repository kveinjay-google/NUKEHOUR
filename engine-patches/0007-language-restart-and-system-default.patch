 	public class GameSettings
 	{
 		public string Platform = "Default";
 
 		[Desc("BCP 47 culture used for in-game text. Applies after restarting the game.")]
-		public string Language = "en";
+		public string Language = DefaultLanguage();
+
+		static string DefaultLanguage()
+		{
+			try
+			{
+				var name = System.Globalization.CultureInfo.CurrentUICulture.Name;
+				if (!string.IsNullOrEmpty(name) &&
+					name.StartsWith("zh", System.StringComparison.OrdinalIgnoreCase))
+					return "zh-CN";
+			}
+			catch (System.Exception)
+			{
+				// Fall back to English if culture detection fails.
+			}
+
+			return "en";
+		}
 
 		[Desc("Open a specific panel instead of the main menu on startup (skirmish, multiplayer, load, settings, replays, missions, editor, assetbrowser, credits, music, content). Cleared after use.")]
 		public string LaunchInto = "";
