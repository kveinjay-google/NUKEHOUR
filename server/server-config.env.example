# One process hosts one room. Copy this file outside the artifact and edit it.
Name=NUKE HOUR Dedicated Server
ListenAddress=0.0.0.0
ListenPort=1234
Map=
Password=
MaxPlayers=8
# OpenRA dedicated servers do not currently publish LAN discovery records.
# This value is reserved and must remain False in Phase 2.
AdvertiseLAN=False
RecordReplays=False
EnableSyncReports=True
EnableSingleplayer=False
RequireAuthentication=False
IdleTimeoutSeconds=900
StatusFile=status/server-status.json
OnlineLobbyUrl=
OnlineLobbyServerId=
NUKEHOUR_LOBBY_REGISTRATION_CREDENTIAL=
OnlineLobbyPublicEndpoint=
OnlineLobbyPublicPort=0
OnlineLobbyRegion=
OnlineLobbyHeartbeatSeconds=15
